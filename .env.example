# Copy to .env and edit values for your environment.

# ------------------------------
# Datastores
# ------------------------------
ES_PORT=9200
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=change_me_local

# Elasticsearch JVM
ES_JAVA_OPTS=-Xms4g -Xmx4g

# Neo4j memory
NEO4J_PAGECACHE_SIZE=2G
NEO4J_HEAP_INITIAL_SIZE=2G
NEO4J_HEAP_MAX_SIZE=2G

# ------------------------------
# Model services (local GPU)
# ------------------------------
HUGGING_FACE_HUB_TOKEN=
# NGC login required for default NVIDIA images:
#   docker login nvcr.io
#   username: $oauthtoken
#   password: <your NGC API key>
VLLM_EMBED_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
VLLM_RERANK_IMAGE=nvcr.io/nvidia/vllm:25.09-py3

EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_SERVED_MODEL_NAME=Qwen/Qwen3-Embedding-8B
EMBED_PORT=8001
EMBED_DTYPE=auto
EMBED_MAX_MODEL_LEN=8192
EMBED_GPU_MEMORY_UTILIZATION=0.45
EMBED_MAX_NUM_SEQS=1
EMBED_DISABLE_TASK=1
EMBED_DISABLE_DIMENSIONS=1
EMBED_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_SERVED_MODEL_NAME=Qwen/Qwen3-Reranker-8B
RERANK_PORT=8002
RERANK_DTYPE=auto
RERANK_MAX_MODEL_LEN=4096
RERANK_GPU_MEMORY_UTILIZATION=0.45
RERANK_MAX_NUM_SEQS=16
RERANK_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# ------------------------------
# Chat provider
# ------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1
CHAT_TEMPERATURE=0.1
CHAT_TOP_P=0.9
CHAT_MAX_COMPLETION_TOKENS=1200
CHAT_TIMEOUT_SEC=120
CHAT_MAX_ATTEMPTS=3
CHAT_RETRY_BACKOFF_SEC=1.5

# ------------------------------
# App API services
# ------------------------------
QUERY_API_PORT=8080
AGENT_API_PORT=8081
FRONTEND_PORT=3000
QUERY_DEFAULT_TOP_K=10
QUERY_FUSION_K=60
QUERY_CANDIDATE_POOL=40
RERANK_ENABLED=1
RERANK_TIMEOUT_SEC=90
RERANK_TOP_N=0
AGENT_DEFAULT_TOP_K=10
AGENT_MAX_CONTEXT_CHUNKS=10
AGENT_MAX_CONTEXT_CHARS_PER_CHUNK=1200
AGENT_REQUIRE_CITATIONS=1
AGENT_MIN_CITATIONS=1
AGENT_MAX_OUTPUT_CITATIONS=8

# ------------------------------
# Pipeline defaults
# ------------------------------
ROUTERKIT_DOCS=kb_artifacts_full_promo_calibrated_run3/documents.jsonl
INGEST_STATE_FILE=localdata/ingest_state.json
EMBED_URL=http://127.0.0.1:8001/v1/embeddings
EMBED_MODEL_RUNTIME=Qwen/Qwen3-Embedding-8B
RERANK_MODEL_RUNTIME=Qwen/Qwen3-Reranker-8B
VECTOR_DIM=4096
TOKENIZER_MODEL=Qwen/Qwen3-Embedding-8B
CHUNK_MODE=tokens
CHUNK_CHARS=1600
CHUNK_OVERLAP=200
CHUNK_TOKENS=1200
CHUNK_OVERLAP_TOKENS=100
ES_GRAPHRAG_INDEX=kb_graphrag_artifacts
QDRANT_GRAPHRAG_COLLECTION=kb_graphrag_artifacts_vec

# Optional additive LLM GraphRAG extraction during `make index-graphrag`.
GRAPHRAG_ENABLE_LLM=0
GRAPHRAG_LLM_ARTIFACT_FAMILIES=entity_description,relationship,claim,community_report_domain,community_report_graph
GRAPHRAG_LLM_EXTRACTION_BATCH_SIZE=3
GRAPHRAG_LLM_MAX_GLEANINGS=1
GRAPHRAG_LLM_MAX_COMPLETION_TOKENS=3000
GRAPHRAG_LLM_EXTRACTION_PROMPT_FILE=prompts/graphrag/extraction_system_prompt.txt
GRAPHRAG_LLM_COMMUNITY_PROMPT_FILE=prompts/graphrag/community_system_prompt.txt
